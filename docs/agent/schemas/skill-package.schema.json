{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drama-canvas.local/schemas/drama-canvas-skill-v1.json",
  "title": "drama-canvas-skill/v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "packageRevision",
    "kind",
    "entry",
    "contract",
    "runtime",
    "permissions"
  ],
  "properties": {
    "schema": {
      "const": "drama-canvas-skill/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "packageRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "kind": {
      "enum": [
        "suite",
        "single"
      ]
    },
    "entry": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.).+$"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.).+$"
          }
        },
        "additionalProperties": true
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema",
        "schemaFile",
        "sha256"
      ],
      "properties": {
        "schema": {
          "const": "drama-canvas-feed/v2"
        },
        "schemaFile": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "prompt",
            "exporter",
            "hybrid"
          ]
        },
        "maxContextTokens": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 200000
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 500,
          "maximum": 32000
        },
        "exporter": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "entry"
          ],
          "properties": {
            "entry": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\.).+$"
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 300
            },
            "network": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": true
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              },
              "documents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "maxTokens": {
                "type": "integer",
                "minimum": 500
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "required": [
        "readProject",
        "readAssets",
        "writeArtifacts",
        "executeScripts",
        "network"
      ],
      "properties": {
        "readProject": {
          "type": "boolean",
          "default": true
        },
        "readAssets": {
          "type": "boolean",
          "default": true
        },
        "writeArtifacts": {
          "type": "boolean",
          "default": true
        },
        "executeScripts": {
          "type": "boolean",
          "default": false
        },
        "network": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publisher": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "files": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "suite"
          }
        }
      },
      "then": {
        "required": [
          "skills"
        ],
        "properties": {
          "skills": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

# Public tenant routing. Keep this file outside the repository; .env is ignored.
CANVAS_MULTI_TENANT=1
CANVAS_BASE_DOMAIN=example.com
CANVAS_OWNER_SLUG=owner
CANVAS_TENANT_DATA_ROOT=C:/drama-canvas-data
CANVAS_COOKIE_SECURE=1
CANVAS_SESSION_COOKIE=canvas_session
CANVAS_SESSION_TTL_SECONDS=2592000

# Required for encrypted provider and TOS credentials.
# Generate one value and keep it backed up outside the application server.
# Example: python -c "import base64,secrets; print('base64:'+base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CANVAS_MASTER_KEY=base64:REPLACE_WITH_A_32_BYTE_URLSAFE_BASE64_KEY

# Platform-level generation protection. Tenant concurrency is the per-user cap.
CANVAS_GENERATION_GLOBAL_CONCURRENCY=4
CANVAS_GENERATION_TENANT_CONCURRENCY=1
CANVAS_GENERATION_PROVIDER_CONCURRENCY=1
CANVAS_GENERATION_QUEUE_TIMEOUT=21600

